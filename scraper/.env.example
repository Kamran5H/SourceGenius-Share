# Copy this file to .env in the same directory and adjust as needed.
# Any variable left unset falls back to the default shown in the comment.

# Folder where scraped CSVs are written. Default: <your home dir>/Scrapped
SG_SAVE_FOLDER=

# How many keyword batches run in parallel. Higher = faster but more
# concurrent requests from this IP, which raises Amazon block risk.
# Default: 1
SG_CONCURRENCY=1

# Run Chrome headless (no visible window). Headless is more detectable to
# Amazon's bot checks than a real headed browser, so this defaults to false
# (headed). Set to "true" only if you understand the added block risk.
SG_HEADLESS=false

# Simulated shopper location — Amazon personalizes search/availability by
# region. These reproduce the original hardcoded NYC / ZIP-10003 profile.
SG_ZIP=10003
SG_LOCALE=en-US
SG_TIMEZONE=America/New_York
SG_LAT=40.7302
SG_LON=-73.9877

# ── Brand reader (POST /brand) — the raw-ASIN path ──────────────────────────
# Real-Chrome persistent profile used to read product-page brands when the
# extension's own fetch/tab reads are walled. Set "Tabs at once" in the panel
# to the SAME number as SG_BRAND_CONCURRENCY so reads never queue.
# SG_BRAND_CONCURRENCY=2   # Pages PER browser. Measured on 96 real ASINs:
#                          #   2 pages (6 in flight): 1168/hr, 96/96, 0.0% errors
#                          #   3 pages (9 in flight):  850/hr, 95/96, 1.0% errors
#                          # Fewer is FASTER — oversubscribed pages stall past the
#                          # 30s goto ceiling and each stall wastes a worker for
#                          # 30s. Raising this measures as less throughput.
# SG_BRAND_REST_MS=45000
# Profile dir — keep it; a warm cookie jar is what avoids Amazon's HTTP 202
# silent block on a cold profile. Deleting it forces a fresh warm-up.
# SG_BRAND_PROFILE=C:\Users\you\.sg-brand-profile

# ── Brand reader pool (raw-ASIN path) ───────────────────────────────────────
# Throughput scales with BROWSER INSTANCES, not pages-per-browser and not page
# weight. Measured on a warm pool: 1 browser ~400 brands/hr, 3 browsers
# ~1166/hr at 0% errors. Each instance is its own real-Chrome persistent
# profile, so a block is per-profile and a failed read retries on another.
# They still share ONE IP — this scales until Amazon's per-IP ceiling bites,
# and past that you get blocks instead of speed. Raise it one step at a time
# and watch `blocked` in /brand/stats, not req/hr.
# SG_BRAND_BROWSERS=3
